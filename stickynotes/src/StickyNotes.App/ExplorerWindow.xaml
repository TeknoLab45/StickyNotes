<Window x:Class="StickyNotes.App.ExplorerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sticky Notes - Explorer" Width="580" Height="500" MinWidth="460" MinHeight="320"
        WindowStartupLocation="CenterScreen" Topmost="True" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource SurfaceBrush}" FontFamily="Segoe UI">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Başlık çubuğu -->
            <Border Grid.Row="0" Background="{StaticResource TitleBarBrush}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource TitleButton}" Content="&#xE921;" ToolTip="Küçült" Click="Minimize_Click"
                                AutomationProperties.AutomationId="MinimizeButton"/>
                        <Button Style="{StaticResource TitleButton}" Content="&#xE8BB;" ToolTip="Kapat" Click="Close_Click"
                                AutomationProperties.AutomationId="CloseExplorerButton"/>
                    </StackPanel>
                    <TextBlock Text="&#xE70B;" FontFamily="{StaticResource IconFont}" FontSize="15" Margin="14,0,8,0"
                               Foreground="{StaticResource InkBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>

            <DockPanel Grid.Row="1" Margin="14,14,14,10">
                <Button x:Name="SortButton" DockPanel.Dock="Right" Margin="8,0,0,0" Height="36" Padding="12,0"
                        Click="SortButton_Click" AutomationProperties.AutomationId="SortButton" ToolTip="Sıralama">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8CB;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SortLabel" Text="Son düzenlenen" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBox x:Name="SearchBox" Style="{StaticResource SearchTextBox}"
                         TextChanged="SearchBox_TextChanged" AutomationProperties.AutomationId="SearchBox"
                         AutomationProperties.Name="Ara"/>
            </DockPanel>

            <DockPanel Grid.Row="2" Margin="14,0,14,10">
                <StackPanel x:Name="ColorFilter" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                            AutomationProperties.AutomationId="ColorFilter"/>
                <TabControl x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged" AutomationProperties.AutomationId="Tabs">
                    <TabItem x:Name="NotesTab" AutomationProperties.AutomationId="NotesTab" AutomationProperties.Name="Notlar">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Notlar"/>
                                <Border CornerRadius="9" Background="#40808080" Padding="7,0" Margin="8,0,0,0">
                                    <TextBlock x:Name="NotesBadge" Text="0" FontSize="11.5" AutomationProperties.AutomationId="NotesBadge"/>
                                </Border>
                            </StackPanel>
                        </TabItem.Header>
                    </TabItem>
                    <TabItem x:Name="TrashTab" AutomationProperties.AutomationId="TrashTab" AutomationProperties.Name="Çöp">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Çöp"/>
                                <Border CornerRadius="9" Background="#40808080" Padding="7,0" Margin="8,0,0,0">
                                    <TextBlock x:Name="TrashBadge" Text="0" FontSize="11.5" AutomationProperties.AutomationId="TrashBadge"/>
                                </Border>
                            </StackPanel>
                        </TabItem.Header>
                    </TabItem>
                </TabControl>
            </DockPanel>

            <ListView x:Name="List" Grid.Row="3" Margin="14,0" MouseDoubleClick="List_MouseDoubleClick" SelectionMode="Extended"
                      AutomationProperties.AutomationId="NoteList">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="16" Height="16" CornerRadius="8" Background="{Binding Brush}"
                                    BorderBrush="#33000000" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,3,0,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="14"/>
                                <TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis" FontSize="12"
                                           Foreground="{StaticResource InkSoftBrush}" Opacity="0.85" Margin="0,1,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Date}" Foreground="{StaticResource InkSoftBrush}"
                                       FontSize="12" Margin="12,0,0,0" VerticalAlignment="Top"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="14,12,14,14">
                <Button x:Name="OpenButton" Content="Aç" MinWidth="88" Margin="6,0,0,0" Style="{StaticResource PrimaryButton}"
                        Click="Open_Click" AutomationProperties.AutomationId="OpenButton"/>
                <Button x:Name="TrashButton" Content="Çöpe at" MinWidth="88" Margin="6,0,0,0"
                        Click="Trash_Click" AutomationProperties.AutomationId="TrashNoteButton"/>
                <Button x:Name="RestoreButton" Content="Geri al" MinWidth="88" Margin="6,0,0,0" Style="{StaticResource PrimaryButton}"
                        Click="Restore_Click" AutomationProperties.AutomationId="RestoreButton"/>
                <Button x:Name="PurgeButton" Content="Kalıcı sil" MinWidth="88" Margin="6,0,0,0" Style="{StaticResource DangerButton}"
                        Click="Purge_Click" AutomationProperties.AutomationId="PurgeButton"/>
                <Button x:Name="EmptyButton" Content="Çöpü boşalt" MinWidth="100" Margin="6,0,0,0" Style="{StaticResource DangerButton}"
                        Click="Empty_Click" AutomationProperties.AutomationId="EmptyTrashButton"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
